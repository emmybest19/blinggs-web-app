{
  "name": "blinggs-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter main-app dev",
    "dev:main": "pnpm --filter main-app dev",
    "dev:super": "pnpm --filter super-admin dev",
    "dev:finance": "pnpm --filter finance-admin dev",
    "dev:compliance": "pnpm --filter compliance-admin dev",
    "dev:support": "pnpm --filter support-admin dev",
    "dev:community": "pnpm --filter community-admin dev",
    "dev:security": "pnpm --filter security-admin dev",
    "dev:admins": "pnpm --filter './apps/*-admin' --parallel dev",
    "dev:all": "pnpm --filter './apps/*' --parallel dev",
    "build": "pnpm -r build",
    "build:main": "pnpm --filter main-app build",
    "build:admins": "pnpm --filter './apps/*-admin' build",
    "preview": "pnpm --filter './apps/*' --parallel preview",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "eslint": "catalog:"
  }
}
